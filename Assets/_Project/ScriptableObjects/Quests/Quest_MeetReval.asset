  title: "\uB974\uBC1C\uC744 \uCC3E\uC544\uC11C"
  objective: {fileID: 11400000, guid: b9b9615b218f0bb41a19a22b37db0c88, type: 2}
  prerequisite: {fileID: 11400000, guid: 7cfb9e2ce132614448968b628dd8beec, type: 2}
  acceptText: "\uC232\uC774 \uC870\uC6A9\uD574\uC84C\uC73C\uB2C8 \uC774\uC81C \uAE38\uC774
    \uC5F4\uB838\uACA0\uAD70.\n\uB9C8\uC744 \uC548\uCABD\uC5D0 \uB974\uBC1C\uC774\uB77C\uB294
    \uC0AC\uB78C\uC774 \uC788\uB124. \uC790\uB124 \uC598\uAE30\uB294 \uD574\uB480\uC73C\uB2C8
    \uAC00\uC11C \uB9CC\uB098\uBCF4\uAC8C."
  progressText: "\uC544\uC9C1 \uC548 \uAC14\uB098? \uB9C8\uC744 \uC548\uCABD\uC77C\uC138.\n"
  completeText: "\uB9CC\uB0AC\uB098 \uBCF4\uAD70. ...\uADF8\uB7FC \uC774\uC81C \uC790\uB124
    \uBAAB\uC774\uACA0\uB124."
  declineText: "\uBC14\uC058\uBA74 \uC5B4\uCA54 \uC218 \uC5C6\uC9C0. \uB9C8\uC74C\uC774
    \uB4E4\uAC70\uB4E0 \uC624\uAC8C."
  lockedText: "\uC232\uC758 \uBAAC\uC2A4\uD130\uBD80\uD130 \uC5B4\uB5BB\uAC8C \uC880
    \uD574\uC8FC\uC9C0 \uC54A\uACA0\uB098."
  rewardGold: 0
